# CycleGen environment

# FastAPI — bind loopback for corporate / laptop installs (no LAN relay).
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Mapbox Directions (driving-traffic). Empty → OSRM free-flow fallback.
# Prefer a public `pk.` token — never put a secret `sk.` token here.
MAPBOX_ACCESS_TOKEN=

# HERE Routing API v8 (profile UI « HERE / ADAS »).
# Provides posted maxSpeed spans + elevation in Flexible Polyline.
HERE_API_KEY=
# Optional override (default https://router.hereapi.com/v8/routes)
# HERE_ROUTING_URL=https://router.hereapi.com/v8/routes

# External geospatial APIs (public defaults — override for self-hosted / intranet)
# For air-gapped PC: point these to internal mirrors OR block outbound firewall
# and accept degraded mode (soft-fail Overpass / elevation → flat / no maxspeed).
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OPEN_ELEVATION_URL=https://api.open-elevation.com/api/v1/lookup
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation

# OSM posted maxspeed overlay (Bellentre 50 km/h, etc.). Set 0 to skip (faster).
CYCLEGEN_OSM_MAXSPEED=1
# Soft upstream curl fallback max seconds (hard requests only)
CYCLEGEN_CURL_MAX_TIME_S=20
CYCLEGEN_MAX_ROUTE_KM=120
CYCLEGEN_MAX_ROUTE_POINTS=12000
# In-memory store bounds (DoS / OOM) — see docs/security.md
CYCLEGEN_MAX_SIMULATIONS=32
CYCLEGEN_SIM_TTL_S=3600
CYCLEGEN_MAX_CORRIDORS=64
CYCLEGEN_CORRIDOR_TTL_S=3600
# Optional API key (P2) — when set, require X-API-Key or Authorization Bearer on /api/*
# CYCLEGEN_API_KEY=
# Localhost CORS regex (default on unless ENV=production)
# CYCLEGEN_CORS_LOCALHOST_REGEX=1
# ENV=production

# SUMO / TraCI
SUMO_HOST=localhost
SUMO_PORT=8813
SUMO_BINARY=sumo
SUMO_HOME=/usr/share/sumo
SUMO_WORK_DIR=/tmp/cyclegen-sumo

# Frontend (Next.js) — talks only to local API by default
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Fetch timeout for API JSON calls (ms). Default 120000.
# NEXT_PUBLIC_API_TIMEOUT_MS=120000
# Optional — must match backend CYCLEGEN_API_KEY when that env is set.
# NEXT_PUBLIC_API_KEY=
# NEXT_PUBLIC_CARTO_API_KEY=

# Browser map tiles still load from tile.openstreetmap.org / cdnjs unless you
# replace MapView TileLayer with offline/cached tiles for air-gap.
