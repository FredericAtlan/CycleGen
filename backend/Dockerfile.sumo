# SUMO-capable image for netconvert + sumo + TraCI tools
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV SUMO_HOME=/usr/share/sumo

RUN apt-get update && apt-get install -y --no-install-recommends \
    sumo \
    sumo-tools \
    python3 \
    python3-pip \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /sumo
EXPOSE 8813

CMD ["sleep", "infinity"]
