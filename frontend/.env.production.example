# CycleGen frontend — production / GitHub Pages static export
# Copy to .env.production.local (or export in CI) before `npm run build:static`.
# See docs/DEPLOY.md at repo root for backend CORS and hosting.

# Browser calls FastAPI directly (no Next.js BFF on static Pages).
NEXT_PUBLIC_API_MODE=direct
NEXT_PUBLIC_STATIC_EXPORT=1

# GitHub *project* Pages: https://<user>.github.io/CycleGen/
# Omit or leave empty for user site root or custom domain.
NEXT_PUBLIC_BASE_PATH=/CycleGen

# Deployed API origin (no trailing slash). Local dev default is http://localhost:8000.
NEXT_PUBLIC_API_URL=https://YOUR-SERVICE.onrender.com
NEXT_PUBLIC_WS_URL=wss://YOUR-SERVICE.onrender.com

# Optional: override fetch timeout (ms). Default 120000.
# NEXT_PUBLIC_API_TIMEOUT_MS=120000

# Optional map tiles (export charts / workbook).
# NEXT_PUBLIC_CARTO_API_KEY=

# Do NOT set NEXT_PUBLIC_API_KEY — secrets belong in server CYCLEGEN_API_KEY (BFF mode only).

# GitHub Pages demo: force OSRM in the UI (HERE + Mapbox stay in shared code,
# but are greyed out so personal API keys are never called from the live demo).
# NEXT_PUBLIC_DEMO_OSRM_ONLY=1
# NEXT_PUBLIC_DISABLE_HERE=1   # legacy alias of the above
